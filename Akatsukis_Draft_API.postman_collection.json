    "name": "Akatsuki's Draft - AI-Enabled Content Sharing Platform API",
    "description": "Complete test suite for Akatsuki's Draft backend (Nodevember 4.0). Covers Authentication, Post Management, Admin Approval Workflow, Public Exploration, and AI Content Improvement.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
