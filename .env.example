# ==========================================
# Akatsuki's Draft - Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/akatsukis_draft

# Authentication (JWT)
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=1d

# Cross-Origin Resource Sharing (CORS)
CLIENT_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=15
AI_RATE_LIMIT_MAX_REQUESTS=10

# AI Improvement Service Configuration
# Supported providers: gemini, openai
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash

# Admin Initialization Script Defaults (used by npm run create-admin)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@akatsukidraft.com
ADMIN_PASSWORD=AdminSecurePassword123!
